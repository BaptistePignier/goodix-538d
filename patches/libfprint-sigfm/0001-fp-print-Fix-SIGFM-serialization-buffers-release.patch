From 75f397f233d270a8141ec826a69a04cc24eccd8b Mon Sep 17 00:00:00 2001
From: Baptiste Pignier <pignier.baptiste@tutanota.com>
Date: Tue, 20 Oct 2026 16:41:42 +0200
Subject: [PATCH 1/8] fp-print: Fix SIGFM serialization buffers release

to_free is a GPtrArray, not a GObject: g_clear_object() raised a critical
and the buffers returned by sigfm_serialize_binary() were leaked. With
G_DEBUG=fatal-criticals the enrolled print was never saved.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libfprint/fp-print.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/libfprint/fp-print.c b/libfprint/fp-print.c
index cf1f7df..a485c64 100644
--- a/libfprint/fp-print.c
+++ b/libfprint/fp-print.c
@@ -681,7 +681,8 @@ fp_print_serialize (FpPrint *print,
   g_variant_builder_open (&builder, G_VARIANT_TYPE_VARDICT);
   g_variant_builder_close (&builder);
 
-  GPtrArray * to_free = g_ptr_array_new ();
+  /* Serialized SIGFM buffers, malloc'ed by sigfm_serialize_binary() */
+  g_autoptr(GPtrArray) to_free = g_ptr_array_new_with_free_func (g_free);
 
   /* Insert NBIS print data for type NBIS, otherwise the GVariant directly */
   if (print->type == FPI_PRINT_NBIS)
@@ -765,7 +766,6 @@ fp_print_serialize (FpPrint *print,
 
   g_variant_get_data (result);
   g_variant_store (result, (*data) + 3);
-  g_clear_object (&to_free);
 
   return TRUE;
 }
